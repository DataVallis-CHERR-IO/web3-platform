# .dockerignore — keep Docker context small and build cache efficient.
# Use **/ so nested workspace folders are excluded too (plain names match only the repo root).
**/node_modules
**/.next
**/.turbo
**/dist
**/*.tsbuildinfo
.git
.github
.vscode
.idea

# Never ship local env files or secrets into the build context
**/.env
**/.env.*
!.env.example
.kamal/secrets*

# Foundry / Solidity (not needed for web image)
packages/contracts/out
packages/contracts/cache
broadcast
.venv-slither

# Test / dev artifacts
coverage
apps/web/e2e
apps/web/test-results
apps/web/playwright-report

# Docs and infra (not needed in image)
docs
infra

# OS files
.DS_Store
*.log
