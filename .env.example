# Environment mode: local | dev | uat | prod
APP_ENV=local

# Database – PgBouncer transaction-mode URL (used by app code at runtime)
DATABASE_URL=postgres://cherrio:cherrio@localhost:6432/cherrio_dev

# Database – direct Postgres URL (used by migrations and seed; bypasses PgBouncer)
# In local dev both can point at the same direct instance (no PgBouncer locally).
DATABASE_URL_DIRECT=postgres://cherrio:cherrio@localhost:5432/cherrio_dev

# Redis connection string
REDIS_URL=redis://localhost:6379

# Web & Auth (Privy)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_PRIVY_APP_ID=placeholder_privy_app_id
PRIVY_APP_SECRET=placeholder_privy_app_secret

# RPC / Infrastructure
ALCHEMY_API_KEY=placeholder_alchemy_api_key
NEXT_PUBLIC_ALCHEMY_API_KEY=placeholder_alchemy_api_key
