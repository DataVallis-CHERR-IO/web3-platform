# .kamal/secrets
# Kamal 2 secrets file — sourced before every kamal command.
# In CI (GitHub Actions), these env vars are injected from GitHub Environment
# secrets/vars. Locally, export them before running kamal commands.
#
# This file MUST NOT contain secret values — only references to env vars.
# See docs/tasks/TASK-022.feedback.md for the full secrets list.

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
DATABASE_URL=$DATABASE_URL
DATABASE_URL_DIRECT=$DATABASE_URL_DIRECT
PRIVY_APP_SECRET=$PRIVY_APP_SECRET
SESSION_SECRET=$SESSION_SECRET
PONDER_RPC_URL_80002=$PONDER_RPC_URL_80002
INDEXER_DATABASE_URL=$INDEXER_DATABASE_URL
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
PRIVATE_FILES_KEY=$PRIVATE_FILES_KEY
