# apps/web/.env.example — names and LOCAL values only. Never put a real secret here.
# Copy what you need into your shell; the repo does not load this file by itself.

# ── Private file storage (ADR-033) ─────────────────────────────────────────────
# Local: the s3mock service from docker-compose.dev.yml (loopback only, accepts
# any credentials). With APP_ENV=local these five default to exactly these values.
S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=local
S3_BUCKET=cherrio-private-local
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# AES-256 key for private files: base64 of exactly 32 bytes. Required everywhere.
# The value below is a PUBLIC, FAKE key for local development and tests only
# (it is the text "cherrio-local-dev-key-not-secret"). Real keys are generated
# with `openssl rand -base64 32` and live in the password manager and GitHub
# Environment secrets only. If a real key is lost, every stored file is unreadable.
PRIVATE_FILES_KEY=Y2hlcnJpby1sb2NhbC1kZXYta2V5LW5vdC1zZWNyZXQ=

# ── Public campaign media (ADR-037) ────────────────────────────────────────────
# A public-read bucket in the same storage account; only non-personal content.
# Local: a second bucket in s3mock. With APP_ENV=local these default to these values.
S3_PUBLIC_BUCKET=cherrio-public-local
S3_PUBLIC_BASE_URL=http://127.0.0.1:9090/cherrio-public-local
