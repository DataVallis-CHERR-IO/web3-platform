{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cherrio/db": "workspace:*",
    "@cherrio/shared": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "nodemailer": "^7.0.9",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@cherrio/config": "workspace:*",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^7.0.2",
    "@types/yauzl": "2.10.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
