[Unit]
Description=CHERR.IO Postgres backup (age-encrypted, rclone upload)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
EnvironmentFile=/opt/cherrio/secrets/infra.env
ExecStart=/bin/bash /opt/cherrio/infra/backups/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cherrio-backup

# Safety: kill after 2 hours if still running
TimeoutStartSec=7200
