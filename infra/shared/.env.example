# infra/shared/.env.example
# Copy to /opt/cherrio/secrets/infra.env on the server and fill in real values.
# chmod 600 /opt/cherrio/secrets/infra.env
# Never commit real values to the repo.

# ──────────────────────────────────────────────────────────
# Postgres
# ──────────────────────────────────────────────────────────

# Superuser password (used by initdb and ensure-databases.sh)
POSTGRES_SUPERUSER_PASSWORD=changeme-superuser

# Per-environment role passwords (created by initdb/01-databases.sh)
POSTGRES_DEV_PASSWORD=changeme-dev
POSTGRES_UAT_PASSWORD=changeme-uat
POSTGRES_PROD_PASSWORD=changeme-prod

# ──────────────────────────────────────────────────────────
# PgBouncer
# ──────────────────────────────────────────────────────────

# Admin password for the pgbouncer virtual database (SHOW STATS, etc.)
PGBOUNCER_ADMIN_PASSWORD=changeme-pgbouncer-admin

# ──────────────────────────────────────────────────────────
# Grafana
# ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme-grafana

# ──────────────────────────────────────────────────────────
# Backups (age + rclone)
# ──────────────────────────────────────────────────────────

# age public key for encrypting backups
# Generate: age-keygen -o /opt/cherrio/secrets/backup-key.age
# Paste the public key (age1...) here
AGE_PUBLIC_KEY=age1_your_public_key_here

# rclone remote name configured with `rclone config`
# Configure: rclone config → name it "cherrio-backups"
# Point to Hetzner Storage Box or Hetzner Object Storage bucket
RCLONE_REMOTE=cherrio-backups

# Optional: Slack/webhook URL for backup failure alerts
BACKUP_ALERT_WEBHOOK=
